# Copy to .env (never committed) and adjust. Read by Expo at build/start time: restart with `npx expo start --clear`.

# Address of the API, without a trailing slash.
# Production (Heroku):
EXPO_PUBLIC_API_URL=https://sobro-api-b00e8bca72f0.herokuapp.com
# Local API from the Android emulator (the emulator reaches the computer at 10.0.2.2); only in a development build:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
